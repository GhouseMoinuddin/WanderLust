<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>

<body>
    <h3>Edit your Listing</h3>
    <form>
        <label for="title">Title</label>
        <input type="text" value="<%= listing.title%>" name="listing[title]">
        <br><br>

        <label for="description">Description</label>
        <textarea value="<%= listing.description%>" name="listing[description]" cols="100" rows="5"></textarea>
        <br><br>

        <label for="image">Image URL</label>
        <input name="listing[image]" value="<%= listing.image%>" type="text">
        <br><br>

        <label for="price">Price</label>
        <input type="number" value="<%= listing.price%>" name="listing[price]">
        <br><br>

        <label for="location">Location</label>
        <input type="text" value="<%= listing.location%>" name="listing[location]">
        <br><br>

        <label for="country">Country</label>
        <input type="text" value="<%= listing.country%>" name="listing[country]">
        <br><br>
        <button>Edit the Listing</button>
    </form>
</body>

</html>