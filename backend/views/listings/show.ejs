<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>

<body>
    <h3>Listing Details:</h3>
    <ul>
        <li>
            <%= listing.title %>
        </li>
        <li>
            <%= listing.description %>
        </li>
        <li>
            <%= listing.location %>
        </li>
        <li>
            ₹<%= listing.price.toLocaleString("en-IN") %>
        </li>
        <li>
            <%= listing.country %>
        </li>

        <br>

        <a href="/listings/<%= listing._id%>/edit">Edit this Listing</a>
    </ul>
</body>

</html>