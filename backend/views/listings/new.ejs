<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>

<body>
    <h3>Create a new Listing</h3>
    <form action="/listings" method="POST">
        <label for="title">Title</label>
        <input type="text" placeholder="Enter title" name="listing[title]">
        <br><br>

        <label for="description">Description</label>
        <textarea placeholder="Enter description" name="listing[description]" cols="100" rows="5"></textarea>
        <br><br>

        <label for="image">Image URL</label>
        <input name="listing[image]" placeholder="enter image URL" type="text">
        <br><br>

        <label for="price">Price</label>
        <input type="number" placeholder="Enter price" name="listing[price]">
        <br><br>

        <label for="location">Location</label>
        <input type="text" placeholder="Enter location" name="listing[location]">
        <br><br>

        <label for="country">Country</label>
        <input type="text" placeholder="Enter country" name="listing[country]">
        <br><br>
        <button>Add a new Listing</button>
    </form>
</body>

</html>